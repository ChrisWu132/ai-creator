# Optional. Set when the environment ships a Chromium that does not match the
# build the installed Playwright expects (common in CI images and sandboxes).
# CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Optional. Overrides the bundled ffmpeg-static binary.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Phase 2 — not used by the recorder.
# HEYGEN_API_KEY=
# ELEVENLABS_API_KEY=
# ANTHROPIC_API_KEY=
